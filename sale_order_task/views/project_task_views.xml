<odoo>
    <record id="view_task_form2_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sale_order_task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="before">
                <field name="state_change_permission" invisible="True" />
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="(//field[@name='state'])[1]" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="(//field[@name='state'])[2]" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="(//field[@name='state'])[3]" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="//field[@name='role_ids']" position="after">
                <field
                    name="mirror_project_id"
                    invisible="not has_project_template and not is_template"
                    domain="[('is_template', '=', False), ('id', '!=', project_id)]"
                />
                <field
                    name="state_sync_direction"
                    invisible="not mirror_project_id or not has_project_template and not is_template"
                />
                <field name="mirror_task_id" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="view_task_kanban_inherit" model="ir.ui.view">
        <field name="name">project.task.card.inherit.sale_order_task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_card" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="before">
                <field name="state_change_permission" invisible="True" />
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="//footer//field[@name='state']" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
        </field>
    </record>

    <!-- Project sharing: the same lock as in the backend, else a portal user picks a stage the server refuses -->
    <record id="project_sharing_project_task_view_form_inherit" model="ir.ui.view">
        <field
            name="name"
        >project.sharing.project.task.form.inherit.sale_order_task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_sharing_project_task_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <field name="state_change_permission" invisible="True" />
            </xpath>
            <xpath expr="//header/field[@name='stage_id']" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="(//field[@name='state'])[1]" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
            <xpath expr="(//field[@name='state'])[2]" position="attributes">
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_sharing_project_task_view_card_inherit" model="ir.ui.view">
        <field
            name="name"
        >project.sharing.project.task.card.inherit.sale_order_task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_sharing_project_task_view_card" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='state'][@widget='project_task_state_selection']"
                position="before"
            >
                <field name="state_change_permission" invisible="True" />
            </xpath>
            <xpath
                expr="//field[@name='state'][@widget='project_task_state_selection']"
                position="attributes"
            >
                <attribute name="readonly">not state_change_permission</attribute>
            </xpath>
        </field>
    </record>
</odoo>
