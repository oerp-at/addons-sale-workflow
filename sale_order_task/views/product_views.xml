<odoo>
    <record id="product_template_form_view_sale_project_inherit" model="ir.ui.view">
        <field
            name="name"
        >product.template.form.view.sale.project.inherit.sale_order_task</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="sale_project.product_template_form_view_invoice_policy_inherit_sale_project"
        />
        <field name="arch" type="xml">
            <field name="task_template_id" position="after">
                <field
                    name="project_template_id"
                    string="Merge Project Template"
                    context="{'default_allow_billable': True, 'default_is_template': True}"
                    domain="[('is_template', '=', True)]"
                    invisible="service_tracking != 'so_project_task_templates'"
                    placeholder="No Project Template"
                />
                <field
                    name="so_task_template_id"
                    string="Merge Task Template"
                    context="{'default_is_template': True}"
                    invisible="service_tracking != 'so_project_task_templates'"
                    placeholder="No Task Template"
                />
            </field>
        </field>
    </record>
</odoo>
